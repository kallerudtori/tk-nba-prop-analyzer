# Environment — never commit your API key
.env

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environment
.venv/
venv/
env/

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Logs
*.log

# Local SQLite artefacts — the app is Postgres-only; a committed .db file on
# Railway's ephemeral filesystem silently loses every graded prediction on
# redeploy, which is why this is ignored rather than tracked.
*.db
*.sqlite
*.sqlite3
