# ── Database (required) ──────────────────────────────────────────────────────
# On Railway: add a PostgreSQL service, then reference it from the web service
# so the credential lives in exactly one place:
#     DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@localhost:5432/tk_props

# ── The Odds API (required) ──────────────────────────────────────────────────
# https://the-odds-api.com
ODDS_API_KEY=your_key_here

# Monthly credit ceiling. Calls are blocked once this is reached, and an alert
# fires at ODDS_CREDIT_ALERT_FRACTION of it.
ODDS_MONTHLY_CREDIT_CEILING=100000
ODDS_CREDIT_ALERT_FRACTION=0.70

# ── Anthropic (required for pick explanations) ───────────────────────────────
ANTHROPIC_API_KEY=your_key_here

# ── Staking ──────────────────────────────────────────────────────────────────
# Quarter Kelly, additionally scaled by measured calibration quality, with a
# hard per-pick maximum in units (1 unit = 1% of bankroll).
KELLY_FRACTION=0.25
KELLY_MAX_UNITS=2.0

# ── NBA (optional) ───────────────────────────────────────────────────────────
# The season is derived from the date. Set this only to pin a historical
# season for a backfill, e.g. 2024-25.
# NBA_SEASON_OVERRIDE=

# ── Flask (optional) ─────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_PORT=5000

# ── Tests (optional) ─────────────────────────────────────────────────────────
# Set to run the Postgres integration suite; unit tests run without it.
TEST_DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/tk_props_test
